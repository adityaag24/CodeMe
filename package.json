{
  "name": "texttocode",
  "displayName": "texttocode",
  "description": "An extension to generate code from text prompts",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./extension.js",
  "contributes": {
    "keybindings": [
      {
        "command": "texttocode.generateQuery",
        "key": "ctrl+alt+g"
      },
      {
        "command": "texttocode.summarizeQuery",
        "key": "ctrl+alt+z"
      },
      {
        "command": "texttocode.defectQuery",
        "key": "ctrl+alt+d"
      },
      {
        "command": "texttocode.refineQuery",
        "key": "ctrl+alt+r"
      },
      {
        "command": "texttocode.translateQuery",
        "key": "ctrl+alt+t"
      }
    ],
    "commands": [
      {
        "command": "texttocode.generateQuery",
        "title": "Generate Code"
      },
      {
        "command": "texttocode.codemesidebar",
        "title": "Show Sidebar"
      },
      {
        "command": "texttocode.summarizeQuery",
        "title": "Summarize Code"
      },
      {
        "command": "texttocode.defectQuery",
        "title": "Find Defect"
      },
      {
        "command": "texttocode.refineQuery",
        "title": "Refine Query"
      },
      {
        "command": "texttocode.translateQuery",
        "title": "Translate"
      }
    ]
  },
  "scripts": {
    "lint": "eslint .",
    "pretest": "npm run lint",
    "test": "node ./test/runTest.js"
  },
  "devDependencies": {
    "@types/glob": "^8.1.0",
    "@types/mocha": "^10.0.1",
    "@types/node": "16.x",
    "@types/vscode": "^1.75.0",
    "@vscode/test-electron": "^2.2.3",
    "eslint": "^8.34.0",
    "glob": "^8.1.0",
    "mocha": "^10.2.0",
    "typescript": "^4.9.5"
  },
  "dependencies": {
    "python-shell": "^5.0.0"
  }
}
